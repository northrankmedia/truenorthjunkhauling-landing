---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../data/business";

const lastUpdated = "September 13, 2026";
---

<BaseLayout
  title="Privacy Policy | True North Junk Hauling"
  description="How True North Junk Hauling collects, uses, and protects the information you share with us, including SMS and email opt-in details."
  path="/privacy"
  noIndex={false}
  logoHref="/"
>
  <section class="bg-pine-2 compass-watermark bg-[position:right_-140px_top_-140px] bg-[length:460px_460px]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-16 pb-16 sm:pt-24 sm:pb-20 text-center flex flex-col items-center gap-5">
      <span class="reveal font-mono text-xs uppercase tracking-[0.25em] text-terracotta-light">Legal</span>
      <h1 class="reveal font-display text-5xl sm:text-6xl text-cream">Privacy Policy</h1>
      <p class="reveal text-cream/75 max-w-xl">Last updated {lastUpdated}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="reveal space-y-8 text-ink leading-relaxed">
      <p>
        True North Junk Hauling ("we," "us," "our") operates as a locally owned junk removal business serving Oxford, MS and Lafayette County. This page explains what information we collect through this landing page, how we use it, and the choices you have.
      </p>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Information We Collect</h2>
        <p>When you call, text, or submit the quote form on this page, we may collect:</p>
        <ul class="mt-3 space-y-2 list-disc pl-5 text-ink-soft">
          <li>Your name, phone number, email address, and ZIP code</li>
          <li>Records of calls and texts, for quality and scheduling purposes</li>
        </ul>
        <p class="mt-3">
          We do not collect payment information through this website. Payment is handled directly, in person or by phone, at the time of service.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">How We Use Your Information</h2>
        <p>We use the information you provide to:</p>
        <ul class="mt-3 space-y-2 list-disc pl-5 text-ink-soft">
          <li>Contact you to confirm pricing and schedule your pickup</li>
          <li>Send appointment reminders and service updates, only if you've opted in</li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">SMS &amp; Text Messaging</h2>
        <p>
          If you text us or check the box to receive SMS updates, we use your mobile number to send messages related to your quote, scheduling, and service reminders. Message and data rates may apply, and message frequency varies based on your activity with us.
        </p>
        <p class="mt-3 font-medium text-ink">
          We do not sell, rent, or share your mobile phone number or SMS opt-in status with third parties or affiliates for marketing purposes.
        </p>
        <p class="mt-3">
          You can opt out of SMS messages at any time by replying STOP to any message. Reply HELP for assistance, or call us directly at {business.phone}.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Cookies &amp; Site Analytics</h2>
        <p>
          This page does not use advertising trackers or sell visitor data. We may use basic conversion tracking through Google Ads to understand which ads and keywords lead to a real quote request. We load web fonts from Google Fonts, which may involve a standard connection to Google's servers.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Data Retention</h2>
        <p>
          We retain contact information for as long as needed to provide service, respond to your inquiry, and meet standard business record-keeping needs. You can request that we delete your information by contacting us using the details below.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Your Choices</h2>
        <p>
          You can ask us to access, correct, or delete the personal information we hold about you, or opt out of SMS communication at any time, by calling or texting us at {business.phone}.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Changes to This Policy</h2>
        <p>
          We may update this policy from time to time as our services or applicable requirements change. The date at the top of this page reflects the most recent update.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-pine-2 mb-3">Contact Us</h2>
        <p>
          Questions about this policy or your information? Call or text {business.phone}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
