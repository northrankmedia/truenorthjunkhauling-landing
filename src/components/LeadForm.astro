---
// Native quote form (replaced the GHL iframe 2026-11-06, GHL subscription
// ended). Posts straight to Web3Forms, which emails the lead to Kevin and
// then redirects the browser to /thank-you. That redirect is what keeps the
// "Request quote" Google Ads conversion working: a page load on /thank-you
// still only happens after a real submission.
//
// Plain HTML form post (no fetch), so it works even if JS fails. JS only
// adds extras: source page / gclid hidden fields, and the email/phone saved
// for enhanced conversions (read back in BaseLayout on /thank-you).
import { business } from "../data/business";

interface Props {
  id?: string;
}
const { id = "lp-lead-form" } = Astro.props;
const redirectUrl = new URL("/thank-you/", business.siteUrl).toString();

const inputClass =
  "w-full bg-white border border-ink/20 px-3.5 py-3 text-base text-ink placeholder:text-ink/40 focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/25";
const labelClass = "block font-mono text-xs uppercase tracking-widest text-ink/70 mb-1.5";
---

<div class="bg-paper border border-ink/10 p-5 sm:p-6">
  <form
    id={id}
    action="https://api.web3forms.com/submit"
    method="POST"
    class="flex flex-col gap-4"
    data-lead-form
  >
    <input type="hidden" name="access_key" value={business.web3formsKey} />
    <input type="hidden" name="subject" value="New quote request from the website" />
    <input type="hidden" name="from_name" value="True North Website" />
    <input type="hidden" name="redirect" value={redirectUrl} />
    <input type="hidden" name="page" value="" data-field-page />
    <input type="hidden" name="gclid" value="" data-field-gclid />
    <!-- Honeypot: real people never see or tick this; bots that do get dropped. -->
    <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

    <div>
      <label for={`${id}-name`} class={labelClass}>Your name</label>
      <input id={`${id}-name`} name="name" type="text" required autocomplete="name" class={inputClass} />
    </div>

    <div>
      <label for={`${id}-phone`} class={labelClass}>Phone</label>
      <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(662) 555-0123" class={inputClass} />
    </div>

    <div>
      <label for={`${id}-email`} class={labelClass}>Email <span class="normal-case tracking-normal text-ink/50">(optional)</span></label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" class={inputClass} />
    </div>

    <div>
      <label for={`${id}-town`} class={labelClass}>Town or ZIP <span class="normal-case tracking-normal text-ink/50">(optional)</span></label>
      <input id={`${id}-town`} name="town_or_zip" type="text" placeholder="Oxford, 38655" class={inputClass} />
    </div>

    <div>
      <label for={`${id}-details`} class={labelClass}>What needs to go?</label>
      <textarea id={`${id}-details`} name="details" rows="4" placeholder="Couch, old fridge, garage full of boxes..." class={inputClass}></textarea>
    </div>

    <button
      type="submit"
      class="mt-1 w-full bg-terracotta hover:bg-terracotta-dark text-cream font-display text-xl tracking-wide py-4 transition-colors disabled:opacity-60"
      data-submit
    >
      Get My Free Quote
    </button>
    <p class="text-center text-xs text-ink/60">We'll call or text you back shortly. No spam, ever.</p>
  </form>
  <p class="text-center text-xs text-ink-faint pt-4">Or skip the form: call or text {business.phone}</p>
</div>

<script is:inline>
  (function () {
    var gclid = new URLSearchParams(location.search).get("gclid");
    try {
      if (gclid) sessionStorage.setItem("tn_gclid", gclid);
      else gclid = sessionStorage.getItem("tn_gclid");
    } catch (e) {}

    document.querySelectorAll("form[data-lead-form]").forEach(function (form) {
      if (form.dataset.wired) return;
      form.dataset.wired = "1";
      var page = form.querySelector("[data-field-page]");
      var gc = form.querySelector("[data-field-gclid]");
      if (page) page.value = location.pathname;
      if (gc && gclid) gc.value = gclid;

      form.addEventListener("submit", function () {
        // Enhanced conversions: save the email/phone just typed so the
        // Google tag on /thank-you can attach it to the conversion.
        var email = (form.email.value || "").trim().toLowerCase();
        var digits = (form.phone.value || "").replace(/\D/g, "");
        if (digits.length === 10) digits = "1" + digits;
        var data = {};
        if (email) data.email = email;
        if (digits.length === 11) data.phone_number = "+" + digits;
        try { sessionStorage.setItem("tn_ud", JSON.stringify(data)); } catch (e) {}

        var btn = form.querySelector("[data-submit]");
        if (btn) { btn.disabled = true; btn.textContent = "Sending..."; }
      });
    });
  })();
</script>
