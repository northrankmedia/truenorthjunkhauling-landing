---
// Trimmed to only the icons this microsite actually uses. Full icon set
// lives in the main repo's Icon.astro if more are ever needed here.
interface Props {
  name: "clock" | "shield" | "tag" | "calendar" | "phone" | "star";
  class?: string;
}
const { name, class: className = "w-5 h-5" } = Astro.props;

const paths: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  shield:
    '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
  tag: '<path d="M3 11.5V5a2 2 0 012-2h6.5L21 11.5 12.5 20 3 11.5z"/><circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 9.5h18M8 3v4M16 3v4"/>',
  phone:
    '<path d="M6 3h3l1.5 4.5L8 9.5a12 12 0 006.5 6.5l2-2.5L21 15v3a2 2 0 01-2 2C10.6 20 4 13.4 4 5a2 2 0 012-2z"/>',
  star: '<path d="M12 3l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L12 17l-5.6 3.1 1.4-6.3L3 9.5l6.4-.6z"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths[name] ?? ""}
/>
