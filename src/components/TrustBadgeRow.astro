---
import { trustBadges } from "../data/business";
import Icon from "./Icon.astro";
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
  {trustBadges.map((b, i) => (
    <span class={`reveal stamp-in-${i + 1} inline-flex items-center justify-center gap-2 border border-dashed border-cream/40 px-3 py-2 font-mono text-[11px] sm:text-xs uppercase tracking-widest text-cream/90 text-center`}>
      <Icon name={b.icon as any} class="w-4 h-4 text-terracotta-light shrink-0" />
      {b.label}
    </span>
  ))}
</div>
