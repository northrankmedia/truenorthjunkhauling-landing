---
// The only layout in this project. This entire microsite exists to convert
// one Google Ads campaign's traffic: no main nav, no mega-menu, no
// navigation away except the phone number and the two legal pages (which
// use this same layout, so they never leak into a different site's chrome).
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";
import { business } from "../data/business";

interface Props {
  title: string;
  description: string;
  path?: string;
  noIndex?: boolean;
  // Pass "/" on any page that ISN'T the main conversion page (privacy,
  // terms), so the logo actually links home there. Leave unset on the main
  // page itself, where the logo stays a non-clickable brand mark.
  logoHref?: string;
}

const { title, description, path = "/", noIndex = true, logoHref } = Astro.props;

const canonicalURL = new URL(path, business.siteUrl).toString();
const ogImageURL = new URL("/images/og-default.jpg", business.siteUrl).toString();
const fullTitle = title.includes("True North") ? title : `${title} | True North Junk Hauling`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18447548524"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18447548524');
    </script>
    <!-- Click-to-call conversion: fires on any tel: link, header, hero,
         sticky mobile bar, thank-you page, without needing an onclick
         attribute on each one individually. Tel: links don't unload the
         page the way a normal navigation does, so a plain fire-and-forget
         event is reliable here. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href^="tel:"]');
        if (!link || typeof gtag !== 'function') return;
        gtag('event', 'conversion', {
          'send_to': 'AW-18447548524/tMJpCIjv6fccEOyAvdxE',
          'value': 1.0,
          'currency': 'USD'
        });
      });
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="True North Junk Hauling" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#163628" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://link.northrankmedia.com" />
    <link rel="dns-prefetch" href="https://link.northrankmedia.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Public+Sans:ital,wght@0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-cream text-ink font-body">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-terracotta focus:text-cream focus:px-4 focus:py-2">
      Skip to content
    </a>

    <header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-ink/10">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <Logo href={logoHref} />
          <a href={business.phoneHref} class="inline-flex items-center gap-2 bg-terracotta hover:bg-terracotta-dark text-cream font-display text-base sm:text-lg tracking-wide px-4 sm:px-5 py-2.5 transition-colors">
            <Icon name="phone" class="w-4 h-4" />
            <span class="hidden sm:inline">{business.phone}</span>
            <span class="sm:hidden">Call Now</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="bg-pine-2 text-cream/60 py-8">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-center sm:text-left">
        <p>&copy; {new Date().getFullYear()} True North Junk Hauling. Oxford, MS. Licensed &amp; insured.</p>
        <p class="flex items-center gap-3">
          <a href="/privacy" class="hover:text-cream transition-colors">Privacy Policy</a>
          <span aria-hidden="true">&middot;</span>
          <a href="/terms" class="hover:text-cream transition-colors">Terms &amp; Conditions</a>
        </p>
      </div>
    </footer>

    <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 grid grid-cols-2 border-t border-ink/10 bg-paper shadow-[0_-4px_16px_rgba(0,0,0,0.08)]">
      <a href={business.smsHref} class="flex items-center justify-center gap-2 py-3.5 font-mono text-sm uppercase tracking-widest text-pine border-r border-ink/10">
        Text
      </a>
      <a href={business.phoneHref} class="flex items-center justify-center gap-2 py-3.5 font-display text-xl tracking-wide bg-terracotta text-cream">
        <Icon name="phone" class="w-4 h-4" /> Call Now
      </a>
    </div>

    <script>
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
